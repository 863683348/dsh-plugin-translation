{
  "name": "dsh-plugin-translation",
  "version": "0.3.2",
  "description": "Translation toolkit for DeepSeek Harness agents: segmentation, term extraction, durable glossary and tone memory, cross-segment consistency checks, source-target QA, heuristic quality scoring, tone guides, and a durable translation memory",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./translation": "./lib/translation.js",
    "./package.json": "./package.json"
  },
