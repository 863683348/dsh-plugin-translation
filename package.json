    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "node --test test/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "bundle",
    "translation",
    "glossary",
    "memo",
    "qa",
    "terminology",
    "consistency",
    "tone",
    "quality-score"
  ],
  "license": "MIT",
